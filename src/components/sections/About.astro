---
import { profile } from '../../data/profile';
import { languages } from '../../data/education';
import Icon from '../Icon.astro';

const focusAreas = [
  'Generative & Agentic AI on Vertex AI',
  'End-to-end data & MLOps pipelines',
  'Serverless, cost-efficient architecture',
  'Cloud security & solution architecture',
];
---

<section id="about" class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">About</span>
      <h2 class="section-title">Turning data &amp; AI into business outcomes</h2>
    </div>

    <div class="about-grid">
      <div class="about-text" data-reveal>
        {profile.summary.map((p) => <p>{p}</p>)}
      </div>

      <aside class="about-card card" data-reveal style="--reveal-delay: 120ms">
        <h3 class="about-card-title">
          <Icon name="sparkles" size={18} /> Focus areas
        </h3>
        <ul class="focus-list">
          {focusAreas.map((f) => (
            <li>
              <Icon name="check" size={16} class="focus-check" /> {f}
            </li>
          ))}
        </ul>

        <div class="about-meta">
          <div>
            <span class="meta-label">Based in</span>
            <span class="meta-value">{profile.location}</span>
          </div>
          <div>
            <span class="meta-label">Languages</span>
            <span class="meta-value">{languages.join(' · ')}</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: start;
  }
  .about-text p {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 1.1rem;
  }
  .about-text p:first-child {
    color: var(--text);
    font-size: 1.16rem;
  }
  .about-card {
    padding: 1.6rem;
  }
  .about-card-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-3);
    margin-bottom: 1.1rem;
  }
  .focus-list {
    display: grid;
    gap: 0.75rem;
  }
  .focus-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--text);
    font-size: 0.96rem;
  }
  .focus-check {
    color: var(--accent-3);
    flex-shrink: 0;
    margin-top: 0.18rem;
  }
  .about-meta {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }
  .meta-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.2rem;
  }
  .meta-value {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
