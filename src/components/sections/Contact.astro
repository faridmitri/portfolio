---
import { profile } from '../../data/profile';
import Icon from '../Icon.astro';

const contacts = [
  { icon: 'mail', label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { icon: 'phone', label: 'Phone', value: profile.phone, href: `tel:${profile.phone.replace(/[^+\d]/g, '')}` },
  { icon: 'map-pin', label: 'Location', value: profile.location, href: undefined },
];
---

<section id="contact" class="section">
  <div class="container">
    <div class="contact-card" data-reveal>
      <div class="contact-glow" aria-hidden="true"></div>
      <div class="contact-inner">
        <span class="eyebrow">Get in touch</span>
        <h2 class="contact-title">Let's build something <span class="gradient-text">impactful</span>.</h2>
        <p class="contact-sub">
          Open to conversations about data engineering, cloud architecture, and applied AI.
          The fastest way to reach me is email or LinkedIn.
        </p>

        <div class="contact-actions">
          <a href={`mailto:${profile.email}`} class="btn btn-primary">
            <Icon name="mail" size={17} /> Email me
          </a>
          {profile.socials
            .filter((s) => s.icon === 'linkedin')
            .map((s) => (
              <a href={s.href} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                <Icon name="linkedin" size={17} /> Connect on LinkedIn
              </a>
            ))}
        </div>

        <ul class="contact-list">
          {contacts.map((c) => {
            const Tag = c.href ? 'a' : 'div';
            return (
              <li>
                <Tag class="contact-item" href={c.href}>
                  <span class="contact-icon"><Icon name={c.icon} size={18} /></span>
                  <span>
                    <span class="contact-label">{c.label}</span>
                    <span class="contact-value">{c.value}</span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: clamp(18px, 3vw, 28px);
    background: linear-gradient(180deg, rgba(14, 21, 37, 0.6), rgba(8, 12, 22, 0.6));
    padding: clamp(2.2rem, 6vw, 4rem);
    overflow: hidden;
    text-align: center;
  }
  .contact-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    height: 80%;
    background: radial-gradient(circle, var(--accent-glow), transparent 70%);
    filter: blur(40px);
    opacity: 0.7;
    pointer-events: none;
  }
  .contact-inner {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
  }
  .eyebrow {
    justify-content: center;
  }
  .contact-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: 1rem;
  }
  .contact-sub {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-top: 1.1rem;
  }
  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .contact-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem 2rem;
    margin-top: 2.6rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-align: left;
  }
  a.contact-item:hover .contact-value {
    color: var(--accent-3);
  }
  .contact-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .contact-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .contact-value {
    display: block;
    color: var(--text);
    font-weight: 500;
    transition: color 0.2s ease;
  }
</style>
