---
import { education, languages } from '../../data/education';
import Icon from '../Icon.astro';
---

<section id="education" class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Background</span>
      <h2 class="section-title">Education &amp; languages</h2>
    </div>

    <div class="edu-layout">
      <div class="edu-list">
        {education.map((e, i) => (
          <article class="edu-card card" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <span class="edu-icon" aria-hidden="true">
              <Icon name="graduation" size={22} />
            </span>
            <div>
              <h3 class="edu-degree">{e.degree}</h3>
              <p class="edu-inst">{e.institution}</p>
              <p class="edu-detail">
                {e.detail && <span>{e.detail}</span>}
                <span class="edu-year">{e.year}</span>
              </p>
            </div>
          </article>
        ))}
      </div>

      <aside class="lang-card card" data-reveal style="--reveal-delay: 120ms">
        <h3 class="lang-title">
          <Icon name="globe" size={18} /> Languages
        </h3>
        <ul class="lang-list">
          {languages.map((l) => (
            <li class="lang-item">
              <Icon name="check" size={15} class="lang-check" /> {l}
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .edu-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1.2rem;
    align-items: start;
  }
  .edu-list {
    display: grid;
    gap: 1rem;
  }
  .edu-card {
    display: flex;
    gap: 1.1rem;
    padding: 1.4rem 1.5rem;
  }
  .edu-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 12px;
    color: var(--accent);
    background: rgba(79, 140, 255, 0.08);
    border: 1px solid var(--border);
  }
  .edu-degree {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .edu-inst {
    color: var(--accent);
    font-size: 0.92rem;
    margin-top: 0.3rem;
  }
  .edu-detail {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .lang-card {
    padding: 1.5rem;
  }
  .lang-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-3);
    margin-bottom: 1.1rem;
  }
  .lang-list {
    display: grid;
    gap: 0.7rem;
  }
  .lang-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.98rem;
  }
  .lang-check {
    color: var(--accent-3);
  }

  @media (max-width: 820px) {
    .edu-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
