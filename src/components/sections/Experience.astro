---
import { experience } from '../../data/experience';
import Icon from '../Icon.astro';
---

<section id="experience" class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Career</span>
      <h2 class="section-title">Professional experience</h2>
      <p class="lead">A decade of building data platforms and AI solutions — from core banking systems to modern cloud-native, GenAI-powered products.</p>
    </div>

    <ol class="timeline">
      {experience.map((job, i) => (
        <li class="t-item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <span class="t-marker" aria-hidden="true">
            <Icon name="briefcase" size={15} />
          </span>
          <article class="t-card card">
            <header class="t-head">
              <div class="t-company-row">
                {/* Company logo: real image if provided, else styled monogram */}
                {job.logo ? (
                  <img
                    src={job.logo}
                    alt={`${job.company} logo`}
                    class="t-logo-img"
                    width="44"
                    height="44"
                    loading="lazy"
                  />
                ) : job.logoFallback ? (
                  <div
                    class="t-logo-mono"
                    style={`--logo-color: ${job.logoFallback.color}`}
                    aria-hidden="true"
                  >
                    {job.logoFallback.initials}
                  </div>
                ) : null}
                <div>
                  <h3 class="t-role">{job.role}</h3>
                  <p class="t-company">
                    {job.company}
                    {job.companyNote && <span class="t-note">{job.companyNote}</span>}
                  </p>
                </div>
              </div>
              <span class="t-dates">{job.start} — {job.end}</span>
            </header>

            <ul class="t-highlights">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>

            {job.tech && (
              <div class="t-tech">
                {job.tech.map((tag) => <span class="chip">{tag}</span>)}
              </div>
            )}
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.4rem;
    padding-left: 2.4rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent), var(--accent-2) 50%, transparent);
    opacity: 0.5;
  }
  .t-item {
    position: relative;
  }
  .t-marker {
    position: absolute;
    left: -2.4rem;
    top: 1.4rem;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--bg-soft);
    border: 1px solid var(--border-strong);
    color: var(--accent-3);
    z-index: 1;
  }
  .t-card {
    padding: 1.5rem clamp(1.2rem, 3vw, 1.8rem);
  }
  .t-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .t-company-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  /* Real logo image */
  .t-logo-img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: contain;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 4px;
    flex-shrink: 0;
  }
  /* Monogram fallback */
  .t-logo-mono {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--logo-color, var(--accent));
    background: color-mix(in srgb, var(--logo-color, var(--accent)) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--logo-color, var(--accent)) 30%, transparent);
    flex-shrink: 0;
  }
  .t-role {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .t-company {
    color: var(--accent);
    font-weight: 500;
    margin-top: 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .t-note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }
  .t-dates {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .t-highlights {
    display: grid;
    gap: 0.7rem;
  }
  .t-highlights li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-muted);
    font-size: 0.97rem;
  }
  .t-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gradient);
  }
  .t-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 560px) {
    .timeline {
      padding-left: 1.9rem;
    }
    .t-marker {
      left: -1.9rem;
      width: 22px;
      height: 22px;
    }
  }
</style>
