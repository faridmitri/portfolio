---
import { expertBadges } from '../../data/expertBadges';
---

<section id="expert-badges" class="section expert-section">
  <div class="container">
    <div class="expert-head" data-reveal>
      <div class="expert-label">
        <!-- Google Cloud logo mark (inline SVG) -->
        <svg viewBox="0 0 24 24" width="22" height="22" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 5.3l1.9 1.9h-3.8L12 5.3zM6.6 7.2H17.4l1.3 1.3H5.3L6.6 7.2zM4.5 9.5h15l1.5 2.5H3L4.5 9.5zM3 12h18l-1.5 2.5H4.5L3 12zM5.3 14.5h13.4l-1.3 1.3H6.6L5.3 14.5zM8.1 16.8h7.8L12 18.7l-3.9-1.9z" fill="#4285F4"/>
        </svg>
        <span>Google Cloud</span>
      </div>
      <h2 class="expert-title">Technical Expert</h2>
      <p class="expert-sub">Earned by demonstrating deep technical expertise in specialized Google Cloud AI domains.</p>
    </div>

    <div class="badges-row">
      {expertBadges.map((b, i) => (
        <a
          href={b.link}
          class="badge-card"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style={`--reveal-delay: ${i * 100}ms`}
          aria-label={`${b.title} — ${b.subtitle}, verify on Credly`}
        >
          <div class="badge-glow" aria-hidden="true"></div>

          <div class="badge-img-wrap">
            <img
              src={b.badgeImage}
              alt={`${b.title} badge`}
              class="badge-img"
              width="140"
              height="140"
              loading="lazy"
            />
          </div>

          <div class="badge-info">
            <p class="badge-sub">{b.subtitle}</p>
            <h3 class="badge-name">{b.title}</h3>
            <span class="badge-date">{b.date}</span>
          </div>

          <span class="badge-verify">
            Verify on Credly
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 13 13 3M7 3h6v6"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .expert-section {
    padding-block: var(--section-pad);
  }

  /* Section header */
  .expert-head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .expert-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #4285F4;
    margin-bottom: 0.8rem;
  }
  .expert-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .expert-sub {
    color: var(--text-muted);
    margin-top: 0.8rem;
    font-size: 1rem;
    max-width: 42rem;
  }

  /* Badge cards row */
  .badges-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .badge-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.2rem 1.6rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(66,133,244,0.07) 0%, rgba(8,12,22,0.8) 60%);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .badge-card:hover {
    transform: translateY(-6px);
    border-color: rgba(66, 133, 244, 0.45);
    box-shadow: 0 20px 50px -20px rgba(66, 133, 244, 0.35);
  }

  /* Animated glow blob behind each card */
  .badge-glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(66,133,244,0.22), transparent 70%);
    filter: blur(28px);
    pointer-events: none;
    transition: opacity 0.3s ease;
    opacity: 0.6;
  }
  .badge-card:hover .badge-glow {
    opacity: 1;
  }

  /* Badge image */
  .badge-img-wrap {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(66,133,244,0.3);
    box-shadow: 0 0 0 6px rgba(66,133,244,0.07);
    margin-bottom: 1.4rem;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    background: transparent;
  }
  .badge-card:hover .badge-img-wrap {
    border-color: rgba(66,133,244,0.6);
    box-shadow: 0 0 0 8px rgba(66,133,244,0.12), 0 0 30px -8px rgba(66,133,244,0.5);
  }
  .badge-img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    display: block;
  }

  /* Text */
  .badge-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4285F4;
    margin-bottom: 0.4rem;
  }
  .badge-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    line-height: 1.25;
  }
  .badge-date {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-faint);
    margin-top: 0.5rem;
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  /* Verify chip */
  .badge-verify {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.3rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .badge-card:hover .badge-verify {
    color: #4285F4;
    border-color: rgba(66,133,244,0.4);
  }

  @media (max-width: 820px) {
    .badges-row { grid-template-columns: 1fr; max-width: 26rem; margin-inline: auto; }
  }
</style>
