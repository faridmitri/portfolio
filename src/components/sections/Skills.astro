---
import { skillGroups } from '../../data/skills';
import Icon from '../Icon.astro';
---

<section id="skills" class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Toolbox</span>
      <h2 class="section-title">Skills &amp; technologies</h2>
    </div>

    <div class="skills-grid">
      {skillGroups.map((group, i) => (
        <div class="skill-card card" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
          <h3 class="skill-cat">
            {group.icon && <Icon name={group.icon} size={18} class="skill-cat-icon" />}
            {group.category}
          </h3>
          <div class="skill-chips">
            {group.skills.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .skill-card {
    padding: 1.4rem;
  }
  .skill-cat {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.1rem;
  }
  .skill-cat-icon {
    color: var(--accent-3);
  }
  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-card .chip {
    color: var(--text);
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .skill-card .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 880px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
